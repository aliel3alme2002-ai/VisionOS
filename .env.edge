# ==========================================
# VisionOS Edge Box Environment Defaults
# ==========================================

NODE_ENV=production
LOG_LEVEL=info

POSTGRES_USER=visionos_edge
POSTGRES_PASSWORD=edge_box_secure_password_replace_me
POSTGRES_DB=visionos_edge
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001

FRIGATE_PORT=5000
FRIGATE_RTSP_PORT=8554
FRIGATE_WEBRTC_PORT=8555

JWT_SECRET=edge_box_signing_key_replace_before_deployment
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
