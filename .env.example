# ==============================================================================
# VisionOS Environment Variables Template
# ==============================================================================

# General Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=visionos
POSTGRES_PASSWORD=visionos_secret_pass
POSTGRES_DB=visionos
DATABASE_URL=postgresql://visionos:visionos_secret_pass@postgres:5432/visionos?schema=public

# Redis Cache & Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO Object Storage Configuration
MINIO_ROOT_USER=visionos_admin
MINIO_ROOT_PASSWORD=visionos_minio_pass
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mosquitto MQTT Broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Monitoring & Dashboards
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_pass

# Admin Tools
PGADMIN_DEFAULT_EMAIL=admin@visionos.io
PGADMIN_DEFAULT_PASSWORD=pgadmin_pass
ADMINER_PORT=8080
