generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ORGANIZATION MODULE
// ==========================================

model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  ownerId     String    @map("owner_id")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  settings      OrganizationSettings?
  branding      OrganizationBranding?
  features      OrganizationFeatures?
  limits        OrganizationLimits?
  users         User[]
  roles         Role[]
  cameras       Camera[]
  cameraGroups  CameraGroup[]
  edgeNodes     EdgeNode[]
  aiModels      AiModel[]
  pipelines     Pipeline[]
  rules         Rule[]
  zones         Zone[]
  workflows     Workflow[]
  alerts        Alert[]
  notifications Notification[]

  @@index([status])
  @@index([ownerId])
  @@map("organizations")
}

model OrganizationSettings {
  id             String    @id @default(uuid())
  organizationId String    @unique @map("organization_id")
  timezone       String    @default("UTC")
  locale         String    @default("en-US")
  currency       String    @default("USD")
  dateFormat     String    @default("YYYY-MM-DD") @map("date_format")
  timeFormat     String    @default("HH:mm:ss") @map("time_format")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OrganizationBranding {
  id             String    @id @default(uuid())
  organizationId String    @unique @map("organization_id")
  logoUrl        String?   @map("logo_url")
  faviconUrl     String?   @map("favicon_url")
  primaryColor   String?   @map("primary_color")
  secondaryColor String?   @map("secondary_color")
  customDomain   String?   @map("custom_domain")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_branding")
}

model OrganizationFeatures {
  id             String    @id @default(uuid())
  organizationId String    @unique @map("organization_id")
  aiInference    Boolean   @default(true) @map("ai_inference")
  cloudRecording Boolean   @default(true) @map("cloud_recording")
  onvifDiscovery Boolean   @default(true) @map("onvif_discovery")
  heatmaps       Boolean   @default(true)
  customWorkflows Boolean  @default(true) @map("custom_workflows")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_features")
}

model OrganizationLimits {
  id             String    @id @default(uuid())
  organizationId String    @unique @map("organization_id")
  maxCameras     Int       @default(100) @map("max_cameras")
  maxEdgeNodes   Int       @default(10) @map("max_edge_nodes")
  maxUsers       Int       @default(50) @map("max_users")
  maxStorageGb   Int       @default(1000) @map("max_storage_gb")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_limits")
}

// ==========================================
// 2. USER & AUTHENTICATION MODULE
// ==========================================

model User {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String    @unique
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  displayName    String    @map("display_name")
  passwordHash   String    @map("password_hash") @default("")
  avatarUrl      String?   @map("avatar_url")
  language       String    @default("en")
  timezone       String    @default("UTC")
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile         UserProfile?
  preferences     UserPreferences?
  security        UserSecurity?
  avatar          UserAvatar?
  userSessions    UserSession[]
  roleAssignments RoleAssignment[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  title       String?
  department  String?
  phoneNumber String?   @map("phone_number")
  bio         String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreferences {
  id                   String    @id @default(uuid())
  userId               String    @unique @map("user_id")
  theme                String    @default("dark")
  emailNotifications   Boolean   @default(true) @map("email_notifications")
  pushNotifications    Boolean   @default(true) @map("push_notifications")
  desktopAlerts        Boolean   @default(true) @map("desktop_alerts")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSecurity {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?   @map("two_factor_secret")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime? @map("password_changed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_securities")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  tokenHash        String    @unique @map("token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  deviceName       String?   @map("device_name")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model UserAvatar {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  storageObjectId String?   @map("storage_object_id")
  thumbnailUrl    String?   @map("thumbnail_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

// ==========================================
// 3. ACCESS CONTROL & RBAC MODULE
// ==========================================

model Role {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  name           String
  description    String?
  systemRole     Boolean   @default(false) @map("system_role")
  parentRoleId   String?   @map("parent_role_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentRole      Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles      Role[]           @relation("RoleHierarchy")
  roleAssignments RoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  groupId     String?  @map("group_id")
  resource    String
  action      String
  scope       String   @default("ORGANIZATION")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  permissionGroup PermissionGroup? @relation(fields: [groupId], references: [id])

  @@unique([resource, action, scope])
  @@map("permissions")
}

model PermissionGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  permissions Permission[]

  @@map("permission_groups")
}

model RoleAssignment {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  roleId         String    @map("role_id")
  organizationId String    @map("organization_id")
  assignedBy     String    @map("assigned_by")
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  expiresAt      DateTime? @map("expires_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId, organizationId])
  @@map("role_assignments")
}

// ==========================================
// 4. VISION MANAGEMENT MODULE
// ==========================================

model Camera {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  name            String
  location        String?
  groupId         String?   @map("group_id")
  manufacturer    String?
  model           String?
  serialNumber    String?   @map("serial_number")
  firmwareVersion String?   @map("firmware_version")
  ipAddress       String    @map("ip_address")
  macAddress      String?   @map("mac_address")
  rtspUrl         String    @map("rtsp_url")
  onvifEnabled    Boolean   @default(true) @map("onvif_enabled")
  streamProfileId String?   @map("stream_profile_id")
  credentialId    String?   @map("credential_id")
  edgeNodeId      String?   @map("edge_node_id")
  status          String    @default("ONLINE")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group         CameraGroup?      @relation(fields: [groupId], references: [id])
  credential    CameraCredential? @relation(fields: [credentialId], references: [id])
  streamProfile StreamProfile?    @relation(fields: [streamProfileId], references: [id])
  edgeNode      EdgeNode?         @relation(fields: [edgeNodeId], references: [id])

  healthHistory    CameraHealth[]
  detections       Detection[]
  zones            Zone[]
  lines            Line[]
  events           VisionEvent[]
  heatmaps         Heatmap[]
  recordings       Recording[]

  @@index([organizationId])
  @@index([edgeNodeId])
  @@index([status])
  @@map("cameras")
}

model CameraGroup {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cameras      Camera[]

  @@index([organizationId])
  @@map("camera_groups")
}

model CameraCredential {
  id          String   @id @default(uuid())
  username    String
  passwordEnc String   @map("password_enc")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cameras Camera[]

  @@map("camera_credentials")
}

model CameraHealth {
  id        String   @id @default(uuid())
  cameraId  String   @map("camera_id")
  status    String
  fps       Float    @default(0)
  bitrate   Int      @default(0)
  latencyMs Int      @default(0) @map("latency_ms")
  timestamp DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, timestamp])
  @@map("camera_health")
}

model StreamProfile {
  id         String   @id @default(uuid())
  name       String
  codec      String   @default("H.264")
  resolution String   @default("1080p")
  fps        Int      @default(30)
  bitrate    Int      @default(4000)
  transport  String   @default("RTSP")
  createdAt  DateTime @default(now()) @map("created_at")

  cameras Camera[]

  @@map("stream_profiles")
}

model EdgeNode {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  hostname       String
  ipAddress      String    @map("ip_address")
  status         String    @default("ONLINE")
  version        String    @default("1.0.0")
  heartbeatAt    DateTime  @default(now()) @map("heartbeat_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cameras         Camera[]
  runtimes        Runtime[]
  capabilities    EdgeCapability[]
  deploymentSlots DeploymentSlot[]
  healthReports   HealthReport[]

  @@index([organizationId])
  @@index([status])
  @@map("edge_nodes")
}

model EdgeCapability {
  id           String   @id @default(uuid())
  edgeNodeId   String   @map("edge_node_id")
  capability   String
  value        String
  createdAt    DateTime @default(now()) @map("created_at")

  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@map("edge_capabilities")
}

model DeploymentSlot {
  id           String   @id @default(uuid())
  edgeNodeId   String   @map("edge_node_id")
  slotNumber   Int      @map("slot_number")
  status       String   @default("FREE")
  createdAt    DateTime @default(now()) @map("created_at")

  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@map("deployment_slots")
}

model DeviceDiscovery {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  ipAddress      String   @map("ip_address")
  macAddress     String?  @map("mac_address")
  manufacturer   String?
  model          String?
  discoveredAt   DateTime @default(now()) @map("discovered_at")

  @@map("device_discoveries")
}

model HealthReport {
  id         String   @id @default(uuid())
  edgeNodeId String   @map("edge_node_id")
  cpuUsage   Float    @map("cpu_usage")
  ramUsage   Float    @map("ram_usage")
  gpuUsage   Float    @default(0) @map("gpu_usage")
  diskUsage  Float    @map("disk_usage")
  timestamp  DateTime @default(now())

  edgeNode EdgeNode @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)

  @@index([edgeNodeId, timestamp])
  @@map("health_reports")
}

// ==========================================
// 5. AI PLATFORM MODULE
// ==========================================

model AiModel {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?
  framework      String
  task           String
  inputShape     String    @map("input_shape")
  outputShape    String    @map("output_shape")
  defaultVersion String?   @map("default_version")
  status         String    @default("READY")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     ModelVersion[]

  @@index([organizationId])
  @@map("ai_models")
}

model ModelVersion {
  id          String   @id @default(uuid())
  modelId     String   @map("model_id")
  version     String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  model       AiModel         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  artifacts   ModelArtifact[]
  deployments Deployment[]

  @@unique([modelId, version])
  @@map("model_versions")
}

model ModelArtifact {
  id             String   @id @default(uuid())
  modelVersionId String   @map("model_version_id")
  fileFormat     String   @map("file_format")
  fileSizeMb     Float    @map("file_size_mb")
  downloadUrl    String   @map("download_url")
  createdAt      DateTime @default(now()) @map("created_at")

  modelVersion ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  @@map("model_artifacts")
}

model Runtime {
  id         String   @id @default(uuid())
  edgeNodeId String   @map("edge_node_id")
  type       String
  version    String
  status     String   @default("ONLINE")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  edgeNode     EdgeNode            @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)
  capabilities RuntimeCapability[]
  health       RuntimeHealth[]
  deployments  Deployment[]
  pipelines    Pipeline[]
  gpuDevices   GpuDevice[]

  @@index([edgeNodeId])
  @@map("runtimes")
}

model RuntimeCapability {
  id         String   @id @default(uuid())
  runtimeId  String   @map("runtime_id")
  capability String
  createdAt  DateTime @default(now()) @map("created_at")

  runtime Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)

  @@map("runtime_capabilities")
}

model RuntimeHealth {
  id        String   @id @default(uuid())
  runtimeId String   @map("runtime_id")
  status    String
  memoryMb  Float    @map("memory_mb")
  timestamp DateTime @default(now())

  runtime Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)

  @@index([runtimeId, timestamp])
  @@map("runtime_health")
}

model Deployment {
  id               String   @id @default(uuid())
  modelVersionId   String   @map("model_version_id")
  runtimeId        String   @map("runtime_id")
  deploymentSlotId String   @map("deployment_slot_id")
  strategy         String   @default("Rolling")
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  modelVersion ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  runtime      Runtime      @relation(fields: [runtimeId], references: [id], onDelete: Cascade)

  @@index([runtimeId])
  @@map("deployments")
}

model Pipeline {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  runtimeId      String   @map("runtime_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runtime      Runtime         @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]

  @@index([organizationId])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String   @map("pipeline_id")
  stageName   String   @map("stage_name")
  order       Int
  configJson  String   @default("{}") @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@map("pipeline_stages")
}

model GpuDevice {
  id          String   @id @default(uuid())
  runtimeId   String   @map("runtime_id")
  name        String
  memoryTotal BigInt   @map("memory_total")
  createdAt   DateTime @default(now()) @map("created_at")

  runtime Runtime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)

  @@map("gpu_devices")
}

model SchedulerJob {
  id        String   @id @default(uuid())
  jobType   String   @map("job_type")
  payload   String
  status    String   @default("PENDING")
  runAt     DateTime @map("run_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("scheduler_jobs")
}

// ==========================================
// 6. VISION INTELLIGENCE MODULE
// ==========================================

model Detection {
  id         String   @id @default(uuid())
  cameraId   String   @map("camera_id")
  pipelineId String   @map("pipeline_id")
  runtimeId  String   @map("runtime_id")
  frameId    String   @map("frame_id")
  timestamp  DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, timestamp])
  @@map("detections")
}

model TrackedObject {
  id         String   @id @default(uuid())
  trackingId String   @unique @map("tracking_id")
  className  String   @map("class_name")
  confidence Float
  x          Float
  y          Float
  width      Float
  height     Float
  velocity   Float    @default(0)
  direction  String?
  zone       String?
  firstSeen  DateTime @map("first_seen")
  lastSeen   DateTime @map("last_seen")

  history ObjectHistory[]

  @@index([trackingId])
  @@map("tracked_objects")
}

model ObjectHistory {
  id         String   @id @default(uuid())
  trackingId String   @map("tracking_id")
  x          Float
  y          Float
  timestamp  DateTime @default(now())

  trackedObject TrackedObject @relation(fields: [trackingId], references: [trackingId], onDelete: Cascade)

  @@index([trackingId, timestamp])
  @@map("object_histories")
}

model Zone {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  cameraId       String   @map("camera_id")
  name           String
  polygon        Json
  type           String   @default("Detection")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  camera       Camera       @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  zoneRules ZoneRule[]
  occupancy Occupancy?

  @@index([cameraId])
  @@map("zones")
}

model ZoneRule {
  id     String @id @default(uuid())
  zoneId String @map("zone_id")
  ruleId String @map("rule_id")

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([zoneId, ruleId])
  @@map("zone_rules")
}

model Line {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  cameraId       String   @map("camera_id")
  name           String
  x1             Float
  y1             Float
  x2             Float
  y2             Float
  createdAt      DateTime @default(now()) @map("created_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
  @@map("lines")
}

model Rule {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  enabled        Boolean  @default(true)
  priority       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conditions   RuleCondition[]
  actions      RuleAction[]
  zoneRules    ZoneRule[]

  @@index([organizationId])
  @@map("rules")
}

model RuleCondition {
  id        String   @id @default(uuid())
  ruleId    String   @map("rule_id")
  field     String
  operator  String
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("rule_conditions")
}

model RuleAction {
  id         String   @id @default(uuid())
  ruleId     String   @map("rule_id")
  actionType String   @map("action_type")
  parameters Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("rule_actions")
}

model VisionEvent {
  id         String   @id @default(uuid())
  type       String
  cameraId   String   @map("camera_id")
  trackingId String?  @map("tracking_id")
  timestamp  DateTime @default(now())
  payload    Json     @default("{}")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  triggers EventTrigger[]
  alerts   Alert[]

  @@index([cameraId, timestamp])
  @@map("vision_events")
}

model EventTrigger {
  id            String   @id @default(uuid())
  visionEventId String   @map("vision_event_id")
  targetType    String   @map("target_type")
  createdAt     DateTime @default(now()) @map("created_at")

  event VisionEvent @relation(fields: [visionEventId], references: [id], onDelete: Cascade)

  @@map("event_triggers")
}

model Heatmap {
  id        String   @id @default(uuid())
  cameraId  String   @map("camera_id")
  timeRange String   @map("time_range")
  gridData  Json     @map("grid_data")
  createdAt DateTime @default(now()) @map("created_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, timeRange])
  @@map("heatmaps")
}

model Occupancy {
  id           String   @id @default(uuid())
  zoneId       String   @unique @map("zone_id")
  currentCount Int      @default(0) @map("current_count")
  maxCapacity  Int      @default(100) @map("max_capacity")
  updatedAt    DateTime @updatedAt @map("updated_at")

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("occupancy")
}

// ==========================================
// 7. WORKFLOW MODULE
// ==========================================

model Workflow {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  executions   WorkflowExecution[]

  @@index([organizationId])
  @@map("workflows")
}

model WorkflowExecution {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  status     String   @default("RUNNING")
  startedAt  DateTime @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_executions")
}

model WorkflowStep {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  stepName   String   @map("step_name")
  actionType String   @map("action_type")
  order      Int
  config     Json     @default("{}")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_steps")
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String
  description String?
  definition  Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("workflow_templates")
}

// ==========================================
// 8. ALERT & NOTIFICATION MODULE
// ==========================================

model Alert {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  eventId        String?   @map("event_id")
  severity       String    @default("MEDIUM")
  message        String
  status         String    @default("NEW")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        VisionEvent?  @relation(fields: [eventId], references: [id])
  history      AlertHistory[]

  @@index([organizationId, status])
  @@map("alerts")
}

model AlertHistory {
  id        String   @id @default(uuid())
  alertId   String   @map("alert_id")
  oldStatus String   @map("old_status")
  newStatus String   @map("new_status")
  changedBy String   @map("changed_by")
  timestamp DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@map("alert_histories")
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  channel        String
  recipient      String
  subject        String
  body           String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("notifications")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  channel   String
  subject   String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notification_templates")
}

// ==========================================
// 9. RECORDING MODULE
// ==========================================

model Recording {
  id        String   @id @default(uuid())
  cameraId  String   @map("camera_id")
  startTime DateTime @map("start_time")
  endTime   DateTime? @map("end_time")
  status    String   @default("RECORDING")
  createdAt DateTime @default(now()) @map("created_at")

  camera   Camera             @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  segments RecordingSegment[]

  @@index([cameraId, startTime])
  @@map("recordings")
}

model RecordingSegment {
  id          String   @id @default(uuid())
  recordingId String   @map("recording_id")
  filePath    String   @map("file_path")
  durationSec Float    @map("duration_sec")
  fileSizeMb  Float    @map("file_size_mb")
  createdAt   DateTime @default(now()) @map("created_at")

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@map("recording_segments")
}

// ==========================================
// 10. SUPPORTING INFRASTRUCTURE MODELS
// ==========================================

model Hotel {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  timezone       String
  status         String   @default("ACTIVE")

  @@map("hotels")
}

model Building {
  id      String @id @default(uuid())
  hotelId String @map("hotel_id")
  name    String

  @@map("buildings")
}

model Floor {
  id         String @id @default(uuid())
  buildingId String @map("building_id")
  name       String
  level      Int

  @@map("floors")
}

model Department {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  code           String
  description    String?

  @@map("departments")
}

model Membership {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  organizationId      String   @map("organization_id")
  roleIds             String[] @map("role_ids")
  status              String   @default("ACTIVE")
  defaultHotelId      String?  @map("default_hotel_id")
  defaultDepartmentId String?  @map("default_department_id")
  lastSelectedContext String?  @map("last_selected_context")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Session {
  id               String    @id @default(uuid())
  sessionId        String    @unique @map("session_id")
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  status           String    @default("ACTIVE")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  deviceName       String?   @map("device_name")
  platform         String?
  browser          String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")

  @@map("sessions")
}

model UserRole {
  userId   String  @map("user_id")
  roleId   String  @map("role_id")
  tenantId String? @map("tenant_id")

  @@id([userId, roleId])
  @@map("user_roles")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       String
  status        String    @default("PENDING")
  retryCount    Int       @default(0) @map("retry_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  @@map("outbox_events")
}

model Invitation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String
  invitedBy      String   @map("invited_by")
  token          String   @unique
  status         String   @default("PENDING")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("invitations")
}
